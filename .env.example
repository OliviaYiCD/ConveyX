# Supabase Cloud
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Direct Postgres (optional — only if pooler connection works)
# DATABASE_URL=postgresql://postgres.your-project:YOUR_PASSWORD@...

# Services
GATEWAY_PORT=3000
IDENTITY_SERVICE_URL=http://localhost:3001
CUSTOMER_SERVICE_URL=http://localhost:3002
SKU_SERVICE_URL=http://localhost:3003
CATALOG_INTELLIGENCE_SERVICE_URL=http://localhost:3004
IDENTITY_PORT=3001
CUSTOMER_PORT=3002
SKU_PORT=3003
CATALOG_INTELLIGENCE_PORT=3004
ORDER_SERVICE_URL=http://localhost:3007
BILLING_SERVICE_URL=http://localhost:3009
ORDER_PORT=3007
BILLING_PORT=3009

# Admin portal (Vite dev server)
ADMIN_PORT=5173
# Customer portal
CUSTOMER_PORTAL_PORT=5174
VITE_DEMO_ENTITY_ID=11111111-1111-1111-1111-111111111111
# Leave empty to use Vite proxy → gateway :3000
VITE_API_URL=

# POC demo user (seed.sql)
DEMO_USER_ID=22222222-2222-2222-2222-222222222222

# Optional — docker compose -f infra/docker-compose.yml up
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222
